+
+/**
+ * The Dump page's props from its two reads: the feed's first page (an action
+ * result) and the total count. Dump is plan-independent, so the header shows
+ * `today`'s ISO week. The cursorless first page can only succeed; the
+ * (unreachable) error branch falls back to an empty feed so the types stay
+ * honest.
+ */
+export function toDumpPageProps(
+  feed: {data: DumpFeedPage} | {error: unknown},
+  totalCount: number,
+  today: Date,
+): DumpPageData {
+  const {entries, nextCursor} =
+    'data' in feed ? feed.data : {entries: [], nextCursor: null};
+  return {
+    periodKey: getISOWeekKey(today),
+    initialEntries: entries,
+    initialNextCursor: nextCursor,
+    initialTotalCount: totalCount,
+  };
+}

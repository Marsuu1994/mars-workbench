+'use client';
+
+import {BoardHeader} from '@/components/domain/shared/BoardHeader';
+import type {DumpPageData} from '@/types/dump';
+import {useDumpFeed} from '@/hooks/useDumpFeed';
+import {DUMP_COLUMN_MAX_W} from './constants';
+import {DumpTitleBar} from './DumpTitleBar';
+import {DumpComposer} from './DumpComposer';
+import {DumpFeed} from './DumpFeed';
+import {DumpPageContext, type DumpPageContextValue} from './DumpPageContext';
+
+/**
+ * The Dump page (/kanban/dump): shared app header + dump title bar, a pinned
+ * composer above a scrolling day-grouped feed. Owns the feed — seeded from
+ * the server, then client state (capture prepends, load-more appends) — and
+ * both writes, which its components reach through DumpPageContext rather
+ * than callback props.
+ */
+export const DumpPage = ({periodKey, ...feedSeed}: DumpPageData) => {
+  const {
+    entries,
+    totalCount,
+    hasMore,
+    isAppending,
+    captureError,
+    capture,
+    loadMore,
+  } = useDumpFeed(feedSeed);
+
+  const pageContext: DumpPageContextValue = {capture, captureError, loadMore};
+
+  return (
+    <DumpPageContext value={pageContext}>
+      <div className="flex flex-col h-full">
+        <BoardHeader periodKey={periodKey} />
+        <DumpTitleBar totalCount={totalCount} />
+
+        <div className="flex-shrink-0 border-b border-base-content/10 px-4 py-3">
+          <div className={`mx-auto w-full ${DUMP_COLUMN_MAX_W}`}>
+            <DumpComposer />
+          </div>
+        </div>
+
+        <div className="flex-1 min-h-0 overflow-y-auto">
+          <div
+            className={`mx-auto w-full ${DUMP_COLUMN_MAX_W} px-4 py-4 pb-12`}
+          >
+            <DumpFeed
+              entries={entries}
+              hasMore={hasMore}
+              isAppending={isAppending}
+            />
+          </div>
+        </div>
+      </div>
+    </DumpPageContext>
+  );
+};
diff --git a/src/components/domain/dump/DumpPageContext.ts b/src/components/domain/dump/DumpPageContext.ts
new file mode 100644
index 0000000..2057abd
--- /dev/null
+++ b/src/components/domain/dump/DumpPageContext.ts
@@ -0,0 +1,27 @@
+import {createContext, use} from 'react';
+
+/**
+ * What the Dump page's components read and do without threading it through
+ * props: capture and load-more, bound to the page's feed, and the last
+ * capture's error. `DumpPage` provides it; the entries still come down as
+ * props.
+ */
+export interface DumpPageContextValue {
+  /** Prepends the entry optimistically; resolves `ok: false` when it failed */
+  capture: (content: string) => Promise<{ok: boolean}>;
+  /** Why the last capture failed; null: it didn't */
+  captureError: string | null;
+  /** Appends the next page of older entries */
+  loadMore: () => void;
+}
+
+export const DumpPageContext = createContext<DumpPageContextValue | null>(null);
+
+/** The Dump page's context; only its components render inside it. */
+export const useDumpPageContext = (): DumpPageContextValue => {
+  const context = use(DumpPageContext);
+  if (!context) {
+    throw new Error('useDumpPageContext must be used within DumpPage');
+  }
+  return context;
+};

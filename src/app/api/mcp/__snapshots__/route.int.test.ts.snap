          "items": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
          "type": "array",
        },
        "title": {
          "description": "A new name",
          "minLength": 1,
          "type": "string",
        },
        "updateSteps": {
          "default": [],
          "description": "A new title, description or size for steps that are not done",
          "items": {
            "properties": {
              "description": {
                "description": "A new description; an empty string clears it",
                "type": "string",
              },
              "size": {
                "description": "Effort: EXTRA_SMALL ~1h, SMALL ~2h, MEDIUM ~3h, LARGE ~5h, EXTRA_LARGE ~8h",
                "enum": [
                  "EXTRA_SMALL",
                  "SMALL",
                  "MEDIUM",
                  "LARGE",
                  "EXTRA_LARGE",
                ],
                "type": "string",
              },
              "stepId": {
                "description": "A stepId from get_planning_context",
                "format": "uuid",

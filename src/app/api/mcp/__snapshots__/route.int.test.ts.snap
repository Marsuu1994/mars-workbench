            "type": "string",
          },
          "type": "array",
        },
        "removeTemplateIds": {
          "default": [],
          "description": "templateIds to take out of the plan",
          "items": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
          "type": "array",
        },
        "updateTemplates": {
          "default": [],
          "description": "A new type and/or frequency for templates already in the plan",
          "items": {
            "properties": {

            ],
            "type": "object",
          },
          "type": "array",
        },
      },
      "required": [
        "planId",
      ],
      "type": "object",
    },
    "name": "update_plan",
    "title": "Update plan",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "If you haven't read get_planning_guide_before_everything in this conversation, or no longer have it, call it first. Change a habit (templateId from get_planning_context): its title, description or size; only what you pass changes. It applies to task instances generated from now on; ones already generated keep their old title and size. How often it runs this week is set with update_plan instead. Agree on the change with the user before calling.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "description": {
          "description": "A new description",
          "minLength": 1,
          "type": "string",
        },
        "size": {
          "description": "Effort: EXTRA_SMALL ~1h, SMALL ~2h, MEDIUM ~3h, LARGE ~5h, EXTRA_LARGE ~8h",
          "enum": [
            "EXTRA_SMALL",
            "SMALL",
            "MEDIUM",
            "LARGE",
            "EXTRA_LARGE",
          ],
          "type": "string",
        },
        "templateId": {
          "description": "A templateId from get_planning_context",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "title": {
          "description": "A new name",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "templateId",
      ],
      "type": "object",
    },
    "name": "update_habit",
    "title": "Update habit",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "If you haven't read get_planning_guide_before_everything in this conversation, or no longer have it, call it first. Create a project: a goal reached through a finite, ordered path of steps, such as a course or a book (repeating work with no end is a habit instead). Give its title, an optional goal and its steps in order, each with a title, a size and an optional description; aim for 10 steps or fewer, at most 50. Check get_planning_context's projects first so you don't create a second one for the same goal. Returns the project with every step's stepId, in order. Schedules nothing: put steps on the week afterwards with update_plan or create_plan. Agree on the project and its steps with the user before calling.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "goal": {
          "description": "What finishing the project means, in one sentence",
          "type": "string",
        },
        "steps": {
          "default": [],
          "description": "The path in order, step 1 first",
          "items": {
            "properties": {
              "description": {
                "description": "A link, notes, or what done looks like",
                "type": "string",
              },
              "size": {
                "description": "Effort: EXTRA_SMALL ~1h, SMALL ~2h, MEDIUM ~3h, LARGE ~5h, EXTRA_LARGE ~8h",
                "enum": [
                  "EXTRA_SMALL",
                  "SMALL",
                  "MEDIUM",
                  "LARGE",
                  "EXTRA_LARGE",
                ],
                "type": "string",
              },
              "title": {
                "description": "What this step covers, readable on its own, e.g. 'Lesson 3 — Ordering food'",
                "minLength": 1,
                "type": "string",
              },
            },
            "required": [
              "title",
              "size",
            ],
            "type": "object",
          },
          "maxItems": 50,
          "type": "array",
        },
        "title": {
          "description": "The project's name, e.g. 'Spanish A1'",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "title",
      ],
      "type": "object",
    },
    "name": "create_project",
    "title": "Create project",
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "If you haven't read get_planning_guide_before_everything in this conversation, or no longer have it, call it first. Change a project (projectId and stepIds from get_planning_context); only what you pass changes. Rename it or change its goal; add steps (at the end, or before a given step); edit, move or remove steps that aren't done; archive or unarchive it. Done steps are locked, and steps keep their order unless the user asks. Removing a step deletes it, and takes it off the board if it is on this week. Archiving takes every unfinished step off the week — archive only when the user asks. Agree on the change with the user before calling.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "addSteps": {
          "default": [],
          "description": "New steps, in order",
          "items": {
            "properties": {
              "beforeStepId": {
                "description": "Insert the new step right before this step; omit to add it at the end of the path",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "type": "string",
              },
              "description": {
                "description": "A link, notes, or what done looks like",
                "type": "string",
              },
              "size": {
                "description": "Effort: EXTRA_SMALL ~1h, SMALL ~2h, MEDIUM ~3h, LARGE ~5h, EXTRA_LARGE ~8h",
                "enum": [
                  "EXTRA_SMALL",
                  "SMALL",
                  "MEDIUM",
                  "LARGE",
                  "EXTRA_LARGE",
                ],
                "type": "string",
              },
              "title": {
                "description": "What this step covers, readable on its own, e.g. 'Lesson 3 — Ordering food'",
                "minLength": 1,
                "type": "string",
              },
            },
            "required": [
              "title",
              "size",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "archived": {
          "description": "true archives the project — only when the user asks; false unarchives it",
          "type": "boolean",
        },
        "goal": {
          "description": "A new goal; an empty string clears it",
          "type": "string",
        },
        "moveSteps": {
          "default": [],
          "description": "Steps that are not done, moved to a new place in the path — only when the user asks",
          "items": {
            "properties": {
              "beforeStepId": {
                "description": "Move the step right before this one; omit to move it to the end",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "type": "string",
              },
              "stepId": {
                "description": "A stepId from get_planning_context",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "type": "string",
              },
            },
            "required": [
              "stepId",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "projectId": {
          "description": "A projectId from get_planning_context",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "removeStepIds": {
          "default": [],
          "description": "Steps that are not done, to delete",
          "items": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
          "type": "array",
        },
        "title": {
          "description": "A new name",
          "minLength": 1,
          "type": "string",
        },
        "updateSteps": {
          "default": [],
          "description": "A new title, description or size for steps that are not done",
          "items": {
            "properties": {
              "description": {
                "description": "A new description; an empty string clears it",
                "type": "string",
              },
              "size": {
                "description": "Effort: EXTRA_SMALL ~1h, SMALL ~2h, MEDIUM ~3h, LARGE ~5h, EXTRA_LARGE ~8h",
                "enum": [
                  "EXTRA_SMALL",
                  "SMALL",
                  "MEDIUM",
                  "LARGE",
                  "EXTRA_LARGE",
                ],
                "type": "string",
              },
              "stepId": {
                "description": "A stepId from get_planning_context",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "type": "string",
              },
              "title": {
                "description": "What this step covers, readable on its own, e.g. 'Lesson 3 — Ordering food'",
                "minLength": 1,
                "type": "string",
              },
            },
            "required": [
              "stepId",
            ],
            "type": "object",
          },
          "type": "array",
        },
      },
      "required": [
        "projectId",
      ],
      "type": "object",
    },
    "name": "update_project",
    "title": "Update project",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "If you haven't read get_planning_guide_before_everything in this conversation, or no longer have it, call it first. Add one or more one-off tasks to the user's priority matrix — single tasks with nothing behind them (a finite list toward one goal is a project; repeating work is a habit). Give each a title, a size, a quadrant and an optional description; up to 20 per call. Check get_planning_context's oneOffTasks first so you don't add one twice. They land on no week; only the user tracks a one-off onto a week. Returns each task with its taskId, in order. Agree on the tasks and their quadrants with the user before calling.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "tasks": {
          "description": "One-off tasks to add to the priority matrix, in order; up to 20",
          "items": {
            "properties": {
              "description": {
                "description": "Optional notes: a link, details, what done looks like",
                "type": "string",
              },
              "quadrant": {
                "description": "Where it sits on the Eisenhower matrix, named in the app as Do First / Schedule / Squeeze In / Maybe Later. DO_FIRST: urgent and important. SCHEDULE: important, not urgent. SQUEEZE_IN: urgent, not important. MAYBE_LATER: neither",
                "enum": [
                  "DO_FIRST",
                  "SCHEDULE",
                  "SQUEEZE_IN",
                  "MAYBE_LATER",
                ],
                "type": "string",
              },
              "size": {
                "description": "Effort: EXTRA_SMALL ~1h, SMALL ~2h, MEDIUM ~3h, LARGE ~5h, EXTRA_LARGE ~8h",
                "enum": [
                  "EXTRA_SMALL",
                  "SMALL",
                  "MEDIUM",
                  "LARGE",
                  "EXTRA_LARGE",
                ],
                "type": "string",
              },
              "title": {
                "description": "What to do, readable on its own, e.g. 'Renew passport'",
                "minLength": 1,
                "type": "string",
              },
            },
            "required": [
              "title",
              "size",
              "quadrant",
            ],
            "type": "object",
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array",
        },
      },
      "required": [
        "tasks",
      ],
      "type": "object",
    },
    "name": "create_one_off_tasks",
    "title": "Create one-off tasks",
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "If you haven't read get_planning_guide_before_everything in this conversation, or no longer have it, call it first. Mark the user's one-off tasks done (completeTaskIds) or move them to another quadrant (reprioritizeTasks), by taskId from get_planning_context; unfinished tasks only. Done is final — the user can't undo it — so pass only the tasks the user said are done. A task done while on no week counts toward this week's active plan, if there is one. It never puts a task on a week or takes one off: update_plan's removeOneOffTaskIds sends a task on this week back to the matrix. Agree on the change with the user before calling.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "completeTaskIds": {
          "default": [],
          "description": "Unfinished one-off tasks to mark done. Done is final: the user can't undo it",
          "items": {
            "description": "A taskId from get_planning_context",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
          "maxItems": 20,
          "type": "array",
        },
        "reprioritizeTasks": {
          "default": [],
          "description": "Unfinished one-off tasks to move to another quadrant",
          "items": {
            "properties": {
              "quadrant": {
                "description": "Where it sits on the Eisenhower matrix, named in the app as Do First / Schedule / Squeeze In / Maybe Later. DO_FIRST: urgent and important. SCHEDULE: important, not urgent. SQUEEZE_IN: urgent, not important. MAYBE_LATER: neither",
                "enum": [
                  "DO_FIRST",
                  "SCHEDULE",
                  "SQUEEZE_IN",
                  "MAYBE_LATER",
                ],
                "type": "string",
              },
              "taskId": {
                "description": "A taskId from get_planning_context",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "type": "string",
              },
            },
            "required": [
              "taskId",
              "quadrant",
            ],
            "type": "object",
          },
          "maxItems": 20,
          "type": "array",
        },
      },
      "type": "object",
    },
    "name": "update_one_off_tasks",
    "title": "Update one-off tasks",
  },
]
`;

exports[`tools/list > is Claude's contract: names, schemas and descriptions 1`] = `
[
  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "How planning works in Mars Workbench: the rules, the three kinds of work (habits, projects, one-offs), how to plan a week, how to start something new, how to keep one-offs, and what each write changes. Call this before anything else in a conversation, and again if you no longer have it.",
    "inputSchema": {
      "properties": {},
      "type": "object",
    },
    "name": "get_planning_guide_before_everything",
    "title": "Get planning guide",
  },
  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true,
    },
    "description": "If you haven't read get_planning_guide_before_everything in this conversation, or no longer have it, call it first. Read what you need to plan the user's week, habits and projects in Mars Workbench: today's date and week; this week's active plan (its habits with type, frequency and progress so far, plus the one-off tasks and project steps on it); last week's finished plan with per-habit completion stats, its project steps and one-off tasks (done, and unfinished ones that can carry over); the user's habits (templates); their projects, each with its goal, progress and whole path of steps; and their unfinished one-off tasks on the priority matrix, each with its quadrant and whether it is on this week, last week or no week. Call it before you propose or change anything — the ids the other tools take come from here.",
    "inputSchema": {
      "properties": {},
      "type": "object",
    },
    "name": "get_planning_context",
    "title": "Get planning context",
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "If you haven't read get_planning_guide_before_everything in this conversation, or no longer have it, call it first. Create this week's plan — only when get_planning_context shows no activePlan. Run existing habits by templateId in \`templates\`, add brand-new ones in \`newTemplates\`, and put UPCOMING project steps on the week with \`addProjectStepIds\`. Completes lastPlan and moves its unfinished one-off tasks and project steps into the new plan (all of them by default). Task instances and steps land in the user's backlog. Agree on the plan with the user before calling.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "addProjectStepIds": {
          "default": [],
          "description": "UPCOMING project steps to put on this week, by stepId from get_planning_context or create_project",
          "items": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
          "type": "array",
        },
        "carryOverOneOffTaskIds": {
          "description": "Which of lastPlan's unfinished one-off tasks move into this plan. Omit to carry all of them over; [] carries none (the rest return to the priority matrix)",
          "items": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
          "type": "array",
        },
        "carryOverProjectStepIds": {
          "description": "Which of lastPlan's unfinished project steps (state LAST_WEEK) move into this plan. Omit to carry all of them over; [] carries none (the rest return to their projects)",
          "items": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
          "type": "array",
        },
        "description": {
          "description": "A short label for the week's focus, shown on the board",
          "type": "string",
        },
        "mode": {
          "default": "NORMAL",
          "description": "NORMAL: daily tasks on weekdays only. EXTREME: every day, weekends included",
          "enum": [
            "NORMAL",
            "EXTREME",
          ],
          "type": "string",
        },
        "newTemplates": {
          "default": [],
          "description": "Brand-new templates to create and run this week",
          "items": {
            "properties": {
              "description": {
                "minLength": 1,
                "type": "string",
              },
              "frequency": {
                "description": "Instances per day (DAILY) or per week (WEEKLY)",
                "maximum": 10,
                "minimum": 1,
                "type": "integer",
              },
              "size": {
                "description": "Effort: EXTRA_SMALL ~1h, SMALL ~2h, MEDIUM ~3h, LARGE ~5h, EXTRA_LARGE ~8h",
                "enum": [
                  "EXTRA_SMALL",
                  "SMALL",
                  "MEDIUM",
                  "LARGE",
                  "EXTRA_LARGE",
                ],
                "type": "string",
              },
              "title": {
                "minLength": 1,
                "type": "string",
              },
              "type": {
                "description": "DAILY: \`frequency\` instances every day. WEEKLY: \`frequency\` instances for the whole week",
                "enum": [
                  "DAILY",
                  "WEEKLY",
                ],
                "type": "string",
              },
            },
            "required": [
              "title",
              "description",
              "size",
              "type",
              "frequency",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "templates": {
          "default": [],
          "description": "Existing templates to run this week",
          "items": {
            "properties": {
              "frequency": {
                "description": "Instances per day (DAILY) or per week (WEEKLY)",
                "maximum": 10,
                "minimum": 1,
                "type": "integer",
              },
              "templateId": {
                "description": "A templateId from get_planning_context",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "type": "string",
              },
              "type": {
                "description": "DAILY: \`frequency\` instances every day. WEEKLY: \`frequency\` instances for the whole week",
                "enum": [
                  "DAILY",
                  "WEEKLY",
                ],
                "type": "string",
              },
            },
            "required": [
              "templateId",
              "type",
              "frequency",
            ],
            "type": "object",
          },
          "type": "array",
        },
      },
      "type": "object",
    },
    "name": "create_plan",
    "title": "Create plan",
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false,
    },
    "description": "If you haven't read get_planning_guide_before_everything in this conversation, or no longer have it, call it first. Change this week's active plan (activePlan.planId from get_planning_context); only what you pass changes. Removing a habit, or changing its type or frequency, deletes that habit's unfinished task instances (backlog, to-do) and regenerates them in the backlog; completed tasks are never touched. \`addProjectStepIds\` puts UPCOMING project steps in the backlog; \`removeProjectStepIds\` sends steps back to their project. Agree on the change with the user before calling.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "addProjectStepIds": {
          "default": [],
          "description": "UPCOMING project steps to put on this week; they land in the backlog",
          "items": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
          "type": "array",
        },
        "addTemplates": {
          "default": [],
          "description": "Existing templates to add to the plan",
          "items": {
            "properties": {
              "frequency": {
                "description": "Instances per day (DAILY) or per week (WEEKLY)",
                "maximum": 10,
                "minimum": 1,
                "type": "integer",
              },
              "templateId": {
                "description": "A templateId from get_planning_context",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "type": "string",
              },
              "type": {
                "description": "DAILY: \`frequency\` instances every day. WEEKLY: \`frequency\` instances for the whole week",
                "enum": [
                  "DAILY",
                  "WEEKLY",
                ],
                "type": "string",
              },
            },
            "required": [
              "templateId",
              "type",
              "frequency",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "description": {
          "description": "A new label for the week's focus",
          "type": "string",
        },
        "mode": {
          "description": "NORMAL: daily tasks on weekdays only. EXTREME: every day, weekends included",
          "enum": [
            "NORMAL",
            "EXTREME",
          ],
          "type": "string",
        },
        "newTemplates": {
          "default": [],
          "description": "Brand-new templates to create and add to the plan",
          "items": {
            "properties": {
              "description": {
                "minLength": 1,
                "type": "string",
              },
              "frequency": {
                "description": "Instances per day (DAILY) or per week (WEEKLY)",
                "maximum": 10,
                "minimum": 1,
                "type": "integer",
              },
              "size": {
                "description": "Effort: EXTRA_SMALL ~1h, SMALL ~2h, MEDIUM ~3h, LARGE ~5h, EXTRA_LARGE ~8h",
                "enum": [
                  "EXTRA_SMALL",
                  "SMALL",
                  "MEDIUM",
                  "LARGE",
                  "EXTRA_LARGE",
                ],
                "type": "string",
              },
              "title": {
                "minLength": 1,
                "type": "string",
              },
              "type": {
                "description": "DAILY: \`frequency\` instances every day. WEEKLY: \`frequency\` instances for the whole week",
                "enum": [
                  "DAILY",
                  "WEEKLY",
                ],
                "type": "string",
              },
            },
            "required": [
              "title",
              "description",
              "size",
              "type",
              "frequency",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "planId": {
          "description": "activePlan.planId from get_planning_context",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "removeOneOffTaskIds": {
          "default": [],
          "description": "One-off tasks to send back to the priority matrix",
          "items": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
          "type": "array",
        },
        "removeProjectStepIds": {
          "default": [],
          "description": "Project steps on this week to send back to their project",
          "items": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
          "type": "array",
        },
        "removeTemplateIds": {
          "default": [],
          "description": "templateIds to take out of the plan",
          "items": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
          "type": "array",
        },
        "updateTemplates": {
          "default": [],
          "description": "A new type and/or frequency for templates already in the plan",
          "items": {
            "properties": {
              "frequency": {
                "description": "Instances per day (DAILY) or per week (WEEKLY)",
                "maximum": 10,
                "minimum": 1,
                "type": "integer",
              },
              "templateId": {
                "description": "A templateId from get_planning_context",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "type": "string",
              },
              "type": {
                "description": "DAILY: \`frequency\` instances every day. WEEKLY: \`frequency\` instances for the whole week",
                "enum": [
                  "DAILY",

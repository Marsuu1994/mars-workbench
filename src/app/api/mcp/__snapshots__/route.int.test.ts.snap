          "items": {
            "properties": {
              "description": {
                "minLength": 1,
                "type": "string",
              },
              "frequency": {
                "description": "Instances per day (DAILY) or per week (WEEKLY)",
                "maximum": 10,
                "minimum": 1,
                "type": "integer",
              },
              "size": {
                "description": "Effort: EXTRA_SMALL ~1h, SMALL ~2h, MEDIUM ~3h, LARGE ~5h, EXTRA_LARGE ~8h",
                "enum": [
                  "EXTRA_SMALL",
                  "SMALL",
                  "MEDIUM",
                  "LARGE",
                  "EXTRA_LARGE",
                ],
                "type": "string",
              },
              "title": {
                "minLength": 1,
                "type": "string",
              },
              "type": {
                "description": "DAILY: \`frequency\` instances every day. WEEKLY: \`frequency\` instances for the whole week",
                "enum": [
                  "DAILY",
                  "WEEKLY",
                ],
                "type": "string",
              },
            },
            "required": [
              "title",
              "description",
              "size",
              "type",
              "frequency",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "planId": {
          "description": "activePlan.planId from get_planning_context",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
          "type": "string",
        },
        "removeAdhocTaskIds": {
          "default": [],
          "description": "One-off tasks to send back to the priority matrix",
          "items": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",

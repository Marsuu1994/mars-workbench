{
  "name": "mars-workbench",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:themes": "node scripts/check-theme-vars.mjs",
    "setup": "node scripts/setup.mjs",
    "db:setup": "tsx scripts/localDb.ts setup",
    "db:reset": "tsx scripts/localDb.ts reset",
    "db:stop": "tsx scripts/localDb.ts stop",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:deploy:prod": "PRISMA_ENV_FILE=.env.prod prisma migrate deploy",
    "dev:session": "tsx --env-file=.env.local scripts/devSession.ts"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@heroicons/react": "^2.2.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "@prisma/adapter-pg": "^7.1.0",
    "@prisma/client": "^7.1.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "daisyui": "^5.5.8",
    "dotenv": "^17.2.3",
    "mcp-handler": "^2.2.0",
    "next": "^16.0.8",
    "next-intl": "^4.13.0",
    "pg": "^8.16.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.4",
    "eslint-config-prettier": "^10.1.8",
    "knip": "5.88.1",
    "prettier": "3.9.4",
    "prisma": "^7.1.0",
    "tailwindcss": "^4.1.17",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "browserslist": "> 1%"
}

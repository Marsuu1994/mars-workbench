# The local Supabase stack (`npm run db:setup` copies this file to .env.local).
# Every value is the Supabase CLI's fixed local default; production credentials
# live only in .env.prod, read by `npm run db:deploy:prod`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Local dev only: the Supabase user id MCP tool calls act as when a request carries no bearer token — the seeded dev user
MCP_DEV_USER_ID=00000000-0000-4000-8000-000000000001
# Optional: uncomment and set to your Gmail address, then npm run db:reset, so a local Google sign-in lands on the seeded data
# SEED_EMAIL=
